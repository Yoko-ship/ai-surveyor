# Пример файла настроек сервера.
# Скопируйте его в файл .env рядом (без слова example) и впишите свои значения.
# ВАЖНО: настоящий .env в репозиторий не кладут — в нём ключи и пароли.
# Всё, что здесь есть, можно задать и на странице /admin/deploy — значения из этой страницы
# (они лежат в базе, таблица app_settings) имеют приоритет над этим файлом.

# --- Сеть ---
# Порт, на котором работает сервер. На Railway и Render его задаёт сама площадка — не трогайте.
PORT=8000
# Полный адрес, по которому система доступна снаружи. Нужен Telegram-боту и ссылкам в письмах.
SERVER_URL=http://127.0.0.1:8000

# --- Искусственный интеллект (необязательно) ---
# Без ключа система работает полностью, только объяснения собираются по шаблону,
# а поля документов ищутся одними правилами, без подсказки ИИ.
# Провайдер: kimi | openai | anthropic | none
LLM_PROVIDER=none
# Адрес сервиса. Для Kimi (Moonshot): https://api.moonshot.ai/v1 ; для OpenAI: https://api.openai.com/v1
LLM_BASE_URL=
# Название модели. Для Kimi по умолчанию kimi-k3 (пример из официальной документации Moonshot).
LLM_MODEL=
# Ключ доступа. Получается в личном кабинете поставщика. Никому не показывать.
LLM_API_KEY=

# --- Telegram (необязательно) ---
# Токен бота от @BotFather. Без него мини-приложение открывается в «режиме браузера»,
# вход по Telegram недоступен, обычный вход по логину и паролю работает.
TELEGRAM_BOT_TOKEN=

# --- Персональные данные ---
# test — на сервере только обезличенные примеры (тестовый запуск за пределами Узбекистана);
# prod — настоящие данные граждан. Режим prod допустим ТОЛЬКО на сервере в Узбекистане
# (правило проекта № 8). Переключение prod из админки требует подтверждения.
PD_MODE=test

# --- База данных ---
# Сейчас используется SQLite: файл data/surveyor.db, эта переменная не нужна.
# Заготовка на будущее, когда перейдём на PostgreSQL (драйвер ещё не установлен):
# DATABASE_URL=postgresql://пользователь:пароль@адрес:5432/surveyor
DATABASE_URL=

# --- Разное ---
# Режим разработчика: отключает второй шаг входа. На рабочем сервере не включать.
SURVEYOR_DEV=0
