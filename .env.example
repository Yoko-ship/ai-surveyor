# Пример файла настроек сервера.
# Скопируйте его в файл .env рядом (без слова example) и впишите свои значения.
# ВАЖНО: настоящий .env в репозиторий не кладут — в нём ключи и пароли.
# Обычные настройки подключений можно задать и на странице /admin/deploy — значения из этой страницы
# (они лежат в базе, таблица app_settings) имеют приоритет над этим файлом.

# --- Сеть ---
# Порт, на котором работает сервер. На Railway и Render его задаёт сама площадка — не трогайте.
PORT=8000
# Полный адрес, по которому система доступна снаружи. Нужен Telegram-боту и ссылкам в письмах.
SERVER_URL=http://127.0.0.1:8000

# --- Искусственный интеллект (необязательно) ---
# Без ключа система работает полностью, только объяснения собираются по шаблону,
# а поля документов ищутся одними правилами, без подсказки ИИ.
# Провайдер: kimi | openai | anthropic | none
LLM_PROVIDER=none
# Адрес сервиса. Для Kimi (Moonshot): https://api.moonshot.ai/v1 ; для OpenAI: https://api.openai.com/v1
LLM_BASE_URL=
# Название модели. Для Kimi по умолчанию kimi-k3 (пример из официальной документации Moonshot).
LLM_MODEL=
# Ключ доступа. Получается в личном кабинете поставщика. Никому не показывать.
LLM_API_KEY=

# --- Подписка ChatGPT: фундамент закрытого тестирования, ещё не подключена ---
# Эти параметры задаются в окружении процесса (Railway Variables или локальном .env), не в админке.
# 0 сохраняет обычный LLM_PROVIDER. 1 выбирает подписку без автоматического API-fallback.
CHATGPT_PLAN_ENABLED=0
# Только числовые Telegram ID через запятую. Пустой список запрещает всем.
CHATGPT_PLAN_TESTER_IDS=
# Заполняется после официального входа и проверки доступной аккаунту модели.
CHATGPT_PLAN_MODEL=
# OAuth не заменяется LLM_API_KEY. Порядок подключения и ограничения: README.md.

# --- Приватный шлюз к Codex на компьютере владельца ---
# Использует тот же CHATGPT_PLAN_TESTER_IDS. Выбор шлюза исключает fallback к другим провайдерам.
CODEX_GATEWAY_ENABLED=0
CODEX_GATEWAY_URL=
CODEX_GATEWAY_TOKEN=
CODEX_GATEWAY_MODEL=

# --- Telegram (необязательно) ---
# Токен бота от @BotFather. Без него мини-приложение открывается в «режиме браузера»,
# а вход по Telegram недоступен. Сотрудники в этом случае входят через Google (раздел ниже);
# логин и пароль остались служебным входом — для администратора и для случаев, когда
# ни Telegram, ни Google не работают.
TELEGRAM_BOT_TOKEN=

# Имя бота без «собачки» — для ссылки «Открыть бота» на странице входа в обычном браузере
# (вход по одноразовому коду, docs/Telegram мини-апп.md). Можно не заполнять: имя спросим
# у самого Telegram, а если он недоступен — покажем inson_surveyor_bot.
TG_BOT_USERNAME=

# --- Вход через Google ---
# Позволяет сотруднику войти кнопкой «Продолжить с Google», без пароля.
# Значения берутся в кабинете Google (Google Cloud Console → «Учётные данные» →
# «Идентификатор клиента OAuth», тип «Веб-приложение»). Подробная инструкция по шагам —
# docs/Вход через Google.md. Пока эти два поля пустые, кнопка входа просто не показывается.
GOOGLE_CLIENT_ID=
# Секрет того же приложения. Это пароль — никому не пересылать и в репозиторий не класть.
GOOGLE_CLIENT_SECRET=
# Кому разрешён вход. Пусто — пускаем любой аккаунт Google (годится только для проверки).
# Чтобы пускать одних сотрудников компании, впишите: insuranceon.uz
# Несколько доменов — через запятую.
GOOGLE_ALLOWED_DOMAINS=
# ВАЖНО: в кабинете Google, в поле «Разрешённые URI перенаправления», должны быть вписаны
# оба адреса возврата — иначе Google откажет во входе с ошибкой redirect_uri_mismatch:
#   https://ai-surveyor-production.up.railway.app/auth/google/callback
#   http://127.0.0.1:8000/auth/google/callback

# --- Вход в систему ---
# Одноразовый код первого администратора. Нужен только на пустом сервере: с ним первый человек
# заводит себе учётную запись на странице /login (вкладка «Первый вход») или командой /admin КОД боту.
# После использования код гаснет навсегда. Если не задать — сервер сам напечатает код
# в свой журнал при первом запуске (когда пользователей ещё ноль). Никому не пересылать.
ADMIN_BOOTSTRAP_CODE=

# --- Персональные данные ---
# test — на сервере только обезличенные примеры (тестовый запуск за пределами Узбекистана);
# prod — настоящие данные граждан. Режим prod допустим ТОЛЬКО на сервере в Узбекистане
# (правило проекта № 8). Переключение prod из админки требует подтверждения.
PD_MODE=test

# --- База данных ---
# SQLite: каталог базы и загрузок. Пусто — data/ проекта. DATABASE_URL не поддерживается.
STORAGE_DIR=
# 1 — применить версионированные миграции при старте; перед обновлением существующей базы создаётся копия.
# 0 — только проверить версию. Для отдельного обновления: python -m app.migrate
SURVEYOR_AUTO_MIGRATE=1
# embedded — расписание внутри сервера; external — отдельный процесс python -m app.worker.
# Оба процесса используют один STORAGE_DIR. Только один владелец периодических заданий.
SURVEYOR_BACKGROUND_MODE=embedded
# 1 выключает фоновые задания для офлайн-разработки и тестов.
SURVEYOR_NO_BACKGROUND=0
DATABASE_URL=

# --- ИИ специалист: живой поиск на lex.uz ---
# Если в локальной базе нормы по вопросу нет, специалист ищет действующий акт на lex.uz,
# цитирует его дословно и сохраняет в библиотеку (app/legal_live.py). 1 — включено (по умолчанию),
# 0 — выключено: ответы только по локальной базе, как раньше.
LEX_LIVE=1
# Общий предел обращений к lex.uz в час на весь сервер (страницы поиска и актов).
LEX_LIVE_PER_HOUR=60
# Личный предел: живых поисков в час на одного пользователя или гостя (гостям разрешено
# 200 вопросов в час — без этого предела один гость мог бы выбрать весь общий).
LEX_LIVE_PER_USER_HOUR=10
# Соль для ключей кэша живого поиска (случайная строка). Не задана — сервер создаст случайную
# сам и сохранит в базе. Значение в репозиторий не класть.
LEX_CACHE_SALT=

# --- Разное ---
# Режим разработчика. Отключает второй шаг входа (код) и единый вход целиком,
# но ТОЛЬКО для обращений с самого компьютера, где запущен сервер (адрес 127.0.0.1,
# и при этом запрос не пришёл через прокси). Так работает run.bat на компьютере разработчика.
# На рабочем и тестовом сервере эту переменную НЕ задавать: там вход обязателен для всех.
SURVEYOR_DEV=0
