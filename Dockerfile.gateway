FROM node:22-bookworm-slim AS codex
RUN npm install --prefix /opt/codex --omit=dev @openai/codex@0.160.0

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONIOENCODING=utf-8 \
    CODEX_HOME=/codex-state/home PORT=8787
WORKDIR /srv
COPY --from=codex /usr/local/bin/node /usr/local/bin/node
COPY --from=codex /opt/codex /opt/codex
RUN ln -s /opt/codex/node_modules/.bin/codex /usr/local/bin/codex
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
COPY tools/codex_gateway.py ./tools/codex_gateway.py
CMD ["python", "tools/codex_gateway.py", "--from-env"]
