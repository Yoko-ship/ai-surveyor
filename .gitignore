.secrets.env
.env
.env.*
!.env.example
data/photos/
data/backups/
sandbox/
*.log
# база и данные клиентов не публикуются: база собирается на сервере, статистика подтягивается сама
data/surveyor.db
# журнал WAL базы (с 21.09.2026): в нём свежие записи, те же данные людей
data/surveyor.db-wal
data/surveyor.db-shm
data/*.lock
data/uploads/
data/reports/
data/inbox/portfolio/
# материалы клиентов: договоры для анализа и переписка чата
data/analysis/
data/chat/
data/act/
# внутренние документы компании и извлечённые тексты — только на локальной машине
library/*
!library/catalog.json
!library/КАТАЛОГ.md
# исключение: открытые тексты законов (.txt) — нужны специалисту на сервере
!library/01_Законодательство/
library/01_Законодательство/**/*.html
library/01_Законодательство/**/*.doc
library/01_Законодательство/**/*.docx
library/01_Законодательство/**/*.pdf
# исключение: публичные документы других страховщиков (.txt) — специалист отвечает о рынке на сервере;
# оригиналы pdf/doc/docx остаются на локальной машине, отчёты НАПП (xlsx) в эту папку не входят
!library/03_Рынок_НАПП/
library/03_Рынок_НАПП/*
# подпапки (Конкуренты, Рэнкинг snsratings и следующие) — тексты .txt и служебные файлы; оригиналы
# pdf/doc/docx/html и отчёты НАПП xlsx остаются на локальной машине (03.10.2026: вся папка, не только Конкуренты)
!library/03_Рынок_НАПП/*/
library/03_Рынок_НАПП/**/*.html
library/03_Рынок_НАПП/**/*.doc
library/03_Рынок_НАПП/**/*.docx
library/03_Рынок_НАПП/**/*.pdf
library/03_Рынок_НАПП/**/*.xlsx
library/03_Рынок_НАПП/**/*.xls
docs/source/
docs/stat_uz_catalog.json
__pycache__/
*.pyc
.railway/
